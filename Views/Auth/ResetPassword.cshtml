@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nova Senha - VotoTrack</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="/css/theme.css" rel="stylesheet" />
    <script src="/js/theme.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <style>

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bs-body-bg);
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
        }

        .auth-container {
            width: 100%;
            max-width: 450px;
            padding: 20px;
        }

        .auth-card {
            background-color: var(--bs-body-bg);
            border: 1px solid var(--bs-border-color);
            border-radius: 1.5rem;
            padding: 2.5rem;
            box-shadow: 0 10px 30px rgba(0, 0, 20, 0.05);
        }

        .logo-text {
            font-family: 'Public Sans';
            font-weight: 900;
            color: var(--bs-body-color);
            text-decoration: none;
            font-size: 1.5rem;
            display: block;
            margin-bottom: 2rem;
            text-align: center;
        }

        .btn-auth {
            background-color: var(--bs-primary);
            color: white;
            padding: 0.8rem;
            border-radius: 0.75rem;
            font-weight: 600;
            width: 100%;
            border: none;
            margin-top: 1rem;
        }

        .form-floating > .form-control:focus {
            border-color: var(--bs-body-color);
            box-shadow: none;
        }
    </style>
</head>
<body>

    <div class="auth-container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <a href="/" class="logo-text mb-0">VotoTrack</a>
            <button class="btn btn-link nav-link-custom px-2 text-decoration-none text-muted" id="bd-theme" type="button" title="Alternar tema">
                <span class="material-symbols-outlined theme-icon-active" style="font-size: 1.4rem;">light_mode</span>
            </button>
        </div>

        <div class="auth-card">
            <h2 class="h4 text-center mb-4 fw-bold">Nova Senha</h2>
            <p class="text-muted text-center small mb-4">Digite sua nova senha abaixo.</p>

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger" role="alert">
                    @ViewBag.ErrorMessage
                </div>
            }

            <form action="/Auth/ResetPassword" method="post" id="resetForm">
                <input type="hidden" name="AccessToken" id="accessToken">
                
                <div class="form-floating mb-3">
                    <input type="password" class="form-control" id="password" name="Password" placeholder="Senha" required minlength="6">
                    <label>Nova Senha</label>
                </div>
                
                <div class="form-floating mb-3">
                    <input type="password" class="form-control" id="confirmPassword" placeholder="Confirmar Senha" required>
                    <label>Confirmar Nova Senha</label>
                </div>

                <button type="submit" class="btn-auth" id="submitBtn">Redefinir Senha</button>
            </form>

            <div id="noTokenError" class="alert alert-warning mt-3" style="display:none;">
                O link de recuperação parece inválido ou expirou. Por favor, solicite um novo.
            </div>
        </div>
    </div>

    <script>
        // Captura o token da URL (formato #access_token=...&type=recovery)
        document.addEventListener('DOMContentLoaded', function() {
            const hash = window.location.hash;
            if (hash) {
                const params = new URLSearchParams(hash.substring(1));
                const token = params.get('access_token');
                const type = params.get('type');

                if (token && (type === 'recovery' || type === 'signup')) {
                    document.getElementById('accessToken').value = token;
                } else {
                    showError();
                }
            } else {
                // Se não houver hash, talvez seja um erro ou o usuário entrou direto na página
                showError();
            }

            function showError() {
                document.getElementById('resetForm').style.display = 'none';
                document.getElementById('noTokenError').style.display = 'block';
            }

            // Validação simples de senha
            const form = document.getElementById('resetForm');
            form.addEventListener('submit', function(e) {
                const pass = document.getElementById('password').value;
                const confirm = document.getElementById('confirmPassword').value;
                if (pass !== confirm) {
                    e.preventDefault();
                    alert('As senhas não coincidem!');
                }
            });
        });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

