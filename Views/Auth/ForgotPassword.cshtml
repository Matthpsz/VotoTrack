@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Recuperar Senha - VotoTrack</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <style>
        :root {
            --primary: #041627;
            --background: #f8f9ff;
            --outline-variant: #c4c6cd;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--background);
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
        }

        .auth-container {
            width: 100%;
            max-width: 450px;
            padding: 20px;
        }

        .auth-card {
            background: white;
            border: 1px solid var(--outline-variant);
            border-radius: 1.5rem;
            padding: 2.5rem;
            box-shadow: 0 10px 30px rgba(0, 0, 20, 0.05);
        }

        .logo-text {
            font-family: 'Public Sans';
            font-weight: 900;
            color: var(--primary);
            text-decoration: none;
            font-size: 1.5rem;
            display: block;
            margin-bottom: 2rem;
            text-align: center;
        }

        .btn-auth {
            background-color: var(--primary);
            color: white;
            padding: 0.8rem;
            border-radius: 0.75rem;
            font-weight: 600;
            width: 100%;
            border: none;
            margin-top: 1rem;
        }

        .form-floating > .form-control:focus {
            border-color: var(--primary);
            box-shadow: none;
        }
    </style>
</head>
<body>

    <div class="auth-container">
        <a href="/" class="logo-text">VotoTrack</a>

        <div class="auth-card">
            <h2 class="h4 text-center mb-4 fw-bold">Recuperar Senha</h2>
            <p class="text-muted text-center small mb-4">Insira seu e-mail para receber as instruções de recuperação.</p>

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger" role="alert">
                    @ViewBag.ErrorMessage
                </div>
            }
            @if (ViewBag.SuccessMessage != null)
            {
                <div class="alert alert-success" role="alert">
                    @ViewBag.SuccessMessage
                </div>
            }

            <form action="/Auth/ForgotPassword" method="post">
                <div class="form-floating mb-3">
                    <input type="email" class="form-control" id="email" name="Email" placeholder="Email" required>
                    <label>E-mail</label>
                </div>
                <button type="submit" class="btn-auth">Enviar Instruções</button>
            </form>

            <div class="text-center mt-4">
                <a href="/Auth" class="text-muted small text-decoration-none">Voltar para o Login</a>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
