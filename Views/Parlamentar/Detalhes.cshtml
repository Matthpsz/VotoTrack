<div class="row">
    <!-- Card de Perfil -->
    <div class="col-md-4">
        <div class="card shadow-sm border-0 mb-4">
            <img src="@Model.FotoUrl" class="card-img-top" alt="Foto Deputado">
            <div class="card-body text-center">
                <h5 class="card-title">@Model.Nome</h5>
                <p class="badge bg-primary">@Model.Partido - @Model.UF</p>
                <button class="btn btn-outline-danger w-100">
                    <i class="bi bi-star"></i> Adicionar à Bancada
                </button>
            </div>
        </div>
    </div>

    <!-- Estatísticas e Gráficos -->
    <div class="col-md-8">
        <div class="card shadow-sm border-0 p-4">
            <h4>Análise de Atuação</h4>
            <div class="row">
                <div class="col-md-6">
                    <canvas id="gaugeFidelidade"></canvas>
                    <p class="text-center mt-2">Fidelidade Partidária</p>
                </div>
                <div class="col-md-6">
                    <canvas id="chartTemas"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>