<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VotoTrack</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css">
    <style>
        .navbar-brand {
            font-weight: bold;
            letter-spacing: -1px;
        }

        .card-custom {
            border-radius: 12px;
            border: none;
            transition: 0.3s;
        }

            .card-custom:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 20px rgba(0,0,0,0.1);
            }
    </style>
</head>
<body class="bg-light text-dark">
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-3 shadow">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Explorar" asp-action="Index">🏛️ VotoTrack</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Explorar" asp-action="Index text-white">Explorar</a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center">
                        <span class="text-secondary me-3">Olá, Matheus</span>
                        <a href="/Auth/Logout" class="btn btn-outline-light btn-sm">Sair</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted border-top py-3 mt-5 bg-white">
        <div class="container text-center">
            &copy; 2026 - VotoTrack - Observatório Legislativo
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>